---
import Contenido from "@/components/Contenido.astro";
import LayoutSecundaria from "@/layouts/LayoutSecundaria.astro";

const searchParams = Astro.url.searchParams;

const cantidad = searchParams.get("cantidad") || 1;
---

<LayoutSecundaria titulo="Inicio" fondo="bg-indigo-200">
  <main class="flex flex-1">
    <Contenido server:defer cantidad={+cantidad}>
        <div class="bg-emerald-200 w-screen h-48" slot="fallback"></div>
    </Contenido>
  </main>
</LayoutSecundaria>
